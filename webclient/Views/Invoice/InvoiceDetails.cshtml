<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="d-print-none mt-3" style="padding-left:10px;">
                <div class="float-start">
                    @*<a href="javascript:window.print()" class="btn btn-success waves-effect waves-light me-1"><i class="fa fa-print"></i>Print</a>*@
                    <a href="@Url.Action("index","invoice")" class="btn btn-primary w-md waves-effect waves-light">Back to list</a>
                    <a href="@Url.Action("salesdetails","sales",new {itemid =Model.Invoiceid})" class="btn btn-primary w-md waves-effect waves-light">Edit</a>
                    @*<a target="_blank" href="@Url.Action("Download","file",new{ fileid = "d2d4c419-59bb-4de4-b78a-ac742ac3b2d7",type="invoice"})" class="btn btn-info">Download Invoice</a>*@
