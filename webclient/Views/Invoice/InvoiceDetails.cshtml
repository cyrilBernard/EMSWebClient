<script>
    $(document).ready(function () {
        $("#statusmodal").modal("hide");
    });
    function showModal() {
        $("#secondmodal").modal("show");
    }
    function getDoc(id, type) {
        var url = '@Url.Action("ViewFilePdf","files")?imageid=' + id + '&type=' + type;
        var el = document.getElementById('ifrm');
        el.src = url;
        $("#statusmodal1").modal("show");
    }
    function updatepayment(a) {
        var chk = $("#paid").prop('checked');
        if (chk == false) {
            alert("please tick checkbox");
            return false;
        }
        var data = {
            itemid: a,
        };
        var val = JSON.stringify(data);
        $.ajax({
            url: "@Url.Action("updatepayment", "ws")",
            data: val,
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                if (result.success) {
                    location.reload();
                }
            },
            error: function (errormessage) {
                alert(errormessage.responseText);
            }
        });
    }
    function confirmparcel(a) {
        var con = confirm("Confirm parcel received?");
        if (con) {
            var data = {
                itemid: a,
            };
            var val = JSON.stringify(data);
            $.ajax({
                url: "@Url.Action("updatestatus", "ws")",
                data: val,
                type: "POST",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    if (result.success) {
                        location.reload();
                    }
                },
                error: function (errormessage) {
                    alert(errormessage.responseText);
                }
            });
        }

    }
    function checkStatus(a) {
        $("#statusmodal").modal("show");
        var data = {
            itemid: a,
        };
        var val = JSON.stringify(data);
        $.ajax({
            url: "@Url.Action("parcelhistory", "ws")",
            data: val,
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                if (result.success) {
                    var datas = JSON.parse(result.data);
                    var html = "";
                    $("#timelineid").html("");
                    var active = "active";
                    $(datas.data).each(function (i, item) {
                        //console.log(item.dateSubmitted);
                        var items = "<div class='tl-item " + active + "'>"
                            + "<div class='tl-dot b-warning' ></div >"
                            + "<div class='tl-content' >"
                            + "<div>" + item.description + "</div> "
                            + "<div class='tl-date text-muted mt-2' ><i>" + item.dateSubmitted + "</i></div >"
                            + "</div>"
                            + "</div>"
                        active = "";
                        $("#timelineid").append(items);
                    })
                    $("#statusmodal").modal("show");
                }
            },
            error: function (errormessage) {
                alert(errormessage.responseText);
            }
        });
    }
</script>