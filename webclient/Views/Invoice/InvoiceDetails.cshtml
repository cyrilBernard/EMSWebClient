                    <button onclick="window.print()" class="btn btn-info">Print</button>
                </div>
            </div>
            <div class="card-body">
                <br />
                <br />
                <div class="col-12">
                    <p style="text-align:center">
                        Ester Music Shop<br />
                        Lot 3, Ground Floor, Lorong Mutiara Inanam,<br />
                        Jalan Nountun Batu 6, Jalan Tuaran<br />
                        88450 Kota Kinabalu
                    </p>
                </div>
                <div class="invoice-title" style="margin-left:15px;">
                    <div class="d-flex align-items-start">
                        <div class="flex-grow-1">
                            @if (!string.IsNullOrEmpty(Model.Customername))
                            {
                                <div class="mb-4">
                                    @*<img src="assets/images/logo-sm.svg" alt="" height="24">*@@*<span class="logo-txt">Minia</span>*@
                                    <h5 class="font-size-15 mb-3">Customer Name:<input type="text" value="cyril" /></h5>
                                    <p class="font-size-14 mb-2">@Model.Customername</p>
                                    <p><i class="mdi mdi-phone align-middle me-1"></i> @Model.Customerphonenumber</p>

                                </div>
                            }

                        </div>
                        <div class="flex-shrink-0">
                            <div class="mb-4">
                                Invoice No : @Model.Invoicenumber
                            </div>
                            <div class="mb-4">
                                Date : @Model.Invoicedate?.ToShortDateString()
                            </div>
                        </div>
                    </div>


                </div>
                @*<hr class="my-4">*@

               @* <div class="py-2 mt-3">
                    <h5 class="font-size-15">Invoice Details</h5>
                </div>*@
                <div class="p-4">
                    <div class="table-responsive">
                        <table class="table table-nowrap align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 70px;">Item.</th>
                                    <th>Description</th>
                                    <th>Quantity</th>
                                    <th>Price</th>
                                    <th>Discount</th>
                                    <th class="text-end" style="width: 120px;">Total Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.invoicedetailslist != null)
                                {
                                    var count = 1;
                                    foreach (var i in Model.invoicedetailslist)
                                    {
                                        <tr>
                                            <th scope="row">@count</th>
                                            <td>
                                                @*<h5 class="font-size-15 mb-1">@i.Productdescription</h5>*@
                                                <p class="font-size-13 text-muted mb-0">@i.Productdescription </p>
                                            </td>
                                            <td>@i.Quantity</td>
                                            <td>RM @webclient.Modules.Utils.ConvertCurrencyToString(i.Price)</td>
                                            <td>@i.Discount</td>
                                            <td class="text-end">RM @webclient.Modules.Utils.ConvertCurrencyToString(i.Totalprice)</td>
                                        </tr>
                                        count++;
                                        totalamount = totalamount + i.Totalprice;
                                    }
                                }

                                <tr><td class="border-0"><p>@Model.remarks</p></td></tr>
                                <tr>
                                    <th scope="row" colspan="5" class="border-0 text-end">Sub Total</th>
                                    <td class="border-0 text-end"><h5 class="m-0">RM @webclient.Modules.Utils.ConvertCurrencyToString(totalamount)</h5></td>
                                </tr>

                                <tr>
                                    <th scope="row" colspan="5" class="border-0 text-end">Total</th>
                                    <td class="border-0 text-end"><h5 class="m-0">RM @webclient.Modules.Utils.ConvertCurrencyToString(totalamount)</h5></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<!-- Second modal dialog -->
<div class="modal fade" id="secondmodal" aria-hidden="true" aria-labelledby="exampleModalToggleLabel2" tabindex="-1" style="padding-top:100px;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalToggleLabel2">Update Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table id="tblsale_template" style="display:none;">
                    <tbody>
                        <tr class="rowData">
                            <td>
                                <select class="form-control" data-code="ProductId" name="ProductId" onchange="getprice(this)">
                                    <option value="">Please Select</option>
                                    @if (Model != null && Model.productlist != null)
                                    {
                                        foreach (var item in Model.productlist)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }

                                </select>

                            </td>
                            <td>
                                <input class="form-control calData colData" min="0" value="" data-code="Price" data-cal="calData1" placeholder="0.00" name="Price" readonly />
                            </td>
                            <td>
                                <input class="form-control calData colData" min="0" value="" data-code="Quantity" data-cal="calData2" placeholder="0.00" name="Quantity" />
                            </td>
                            <td>
                                <input class="form-control calData colData" min="0" value="" data-code="Discount" data-cal="calData2" placeholder="0.00" name="Discount" />
                            </td>
                            <td>
                                <input class="form-control totalData" value="" data-code="TotalPrice" readonly />
                            </td>
                            <td><input type="button" onclick="remove_sale(this)" value="Remove" class="btn btn-danger" /></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <!-- Toogle to first dialog, `data-bs-dismiss` attribute can be omitted - clicking on link will close dialog anyway -->
                <button class="btn btn-primary" onclick="updatepayment('@Model.Invoiceid')">Ok</button>
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
