@model PasswordModel

<script src="~/assets/libs/jquery/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Invoice Details</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("index","sales")">Sales List</a></li>
                    <li class="breadcrumb-item active">Sale Details</li>
                </ol>
            </div>

        </div>
    </div>
</div>
<div class="row">
    <form method="post" class="needs-validation" novalidate enctype="multipart/form-data" onsubmit="handleSubmit()" action="changepassword" id="changepassword">
        @Html.AntiForgeryToken()
        <button class="btn btn-primary" onclick="update('save')">Save</button>
        <div class="row gx-2">
            <div class="col-sm-6 mb-3">
                <label class="form-label">Current Password</label>
                <div class="row gx-2">
                    <div class="col-7">
                        <input placeholder="Current Password" type="password" class="form-control" value='@Model.currentpassword' required asp-for="currentpassword">
                        <div class="invalid-feedback">
                            Required!
                        </div>
                    </div>
                </div> <!-- row.// -->
            </div>
        </div> <!-- row.// -->
        <div class="row gx-2">
            <div class="col-sm-6 mb-3">
                <label class="form-label">New Password</label>
                <div class="row gx-2">
                    <div class="col-7">
                        <input placeholder="New Password" type="password" class="form-control" value='@Model.password' required asp-for="password">
                        <div class="invalid-feedback">
                            Required!
                        </div>
                    </div>
                </div> <!-- row.// -->
            </div>
        </div> <!-- row.// -->
        <div class="row gx-2">
            <div class="col-sm-6 mb-3">
                <label class="form-label">Confirm Password</label>
                <div class="row gx-2">
                    <div class="col-7">
                        <input placeholder="Confirm Password" type="password" class="form-control" value='@Model.confirmpassword' required asp-for="confirmpassword">
                        <div class="invalid-feedback">
                            Required!
                        </div>
                    </div>
                </div> <!-- row.// -->
            </div>
        </div> <!-- row.// -->
     
    </form>
</div>

<script>
    function update(a) {
        $("#action").val(a);
        $("#changepassword").submit(function (e) {
            var isValid = this.checkValidity();
            if (!isValid) {
                return false;
            };
        });

    }
    
</script>
