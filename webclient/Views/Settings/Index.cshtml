@model PagingResult<ProductsCategory>
@{
    ViewData["Title"] = "Settings Category List";
}


<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Category List</h3>
            </div>
            <div class="card-body">
                <form asp-action="Index">
                    <div class="row mb-4">
                        <label for="horizontal-firstname-input" class="col-md-2 col-form-label">Category Code :</label>
                        <div class="col-sm-4">
                            <input type="text" name="currentFilter" value="@ViewData["currentFilter"]" class="form-control" />
                        </div>
                        <div class="col-sm-2">
                            <button type="submit" class="btn btn-primary w-md">Search</button>
                        </div>
                    </div>
                </form>
                <div>
                    <a href="@Url.Action("CategoryDetails", "Settings", new { itemid = "" })" class="btn btn-outline-success">Add Category</a>
                </div>
                <hr />
                <table id="tblMember" class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            @*<th>#</th>*@
                            <th>
                                Category Code
                            </th>
                            <th>
                                Category Name
                            </th>
                            <th>
                                Description
                            </th>
                            <th>
                                Status
                            </th>
                            <th>
                                Created Date
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (Model != null && Model.Items != null)
                            {
                                int i = 1;
                                foreach (var item in Model.Items)
                                {
                                    <tr>

                                        <td>
                                            <a href="@Url.Action("CategoryDetails","Settings",new{ itemid = item.Productid})">@item.Productcode</a>

                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Name)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Description)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Status)
                                        </td>
                                        <td>
                                            @webclient.Modules.Utils.ConvertDateTimeToString(item.Createddate)
                                        </td>


                                    </tr>
                                    i++;
                                }
                            }
                        }

                    </tbody>
                </table>
                @if (Model != null)
                {
                    var currentfilter = ViewData["CurrentFilter"] ?? "";
                    var currentsort = ViewData["CurrentSort"] ?? "";
                    Model.Result.currentfilter = currentfilter.ToString();
                    Model.Result.currentsort = currentsort.ToString();
                    Model.Result.Controller = "Index";
                    @Html.Partial("_Paging",Model.Result)
                }


            </div>
        </div>
    </div>
</div>
